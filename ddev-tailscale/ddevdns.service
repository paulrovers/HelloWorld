# systemd-unit voor ddevdns (Linux).
# Installatie:
#   sudo cp ddevdns /usr/local/bin/
#   sudo cp ddevdns.service /etc/systemd/system/
#   sudo systemctl enable --now ddevdns
[Unit]
Description=ddevdns - beantwoordt *.ddev.site met het Tailscale-IP van deze machine
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/ddevdns
Restart=on-failure
RestartSec=3
# Poort 53 zonder root:
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
